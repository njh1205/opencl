// cplx.clh — device-side complex arithmetic (float2 = [re, im]) and THP centered
// modulo; shared by host C++ (-Ikernels) and device OpenCL.
// HPOCL_CPLX_CLH: include guard — Runtime::build() textually inlines headers, so
// several kernels share one TU and `#pragma once` would not be recognized.
#ifndef HPOCL_CPLX_CLH
#define HPOCL_CPLX_CLH

// ---- complex arithmetic (float2 = [re, im]) --------------------------------
// cmul: complex multiply, a * b
static inline float2 cmul(float2 a, float2 b) {
  return (float2)(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}
// cmulc: complex multiply with conjugated first operand, conj(a) * b
static inline float2 cmulc(float2 a, float2 b) {
  return (float2)(a.x * b.x + a.y * b.y, a.x * b.y - a.y * b.x);
}
// cmulr: complex multiply with conjugated second operand, a * conj(b)
static inline float2 cmulr(float2 a, float2 b) {
  return (float2)(a.x * b.x + a.y * b.y, a.y * b.x - a.x * b.y);
}
// cadd: complex add
static inline float2 cadd(float2 a, float2 b) { return (float2)(a.x + b.x, a.y + b.y); }
// csub: complex subtract
static inline float2 csub(float2 a, float2 b) { return (float2)(a.x - b.x, a.y - b.y); }
// cconj: complex conjugate
static inline float2 cconj(float2 a) { return (float2)(a.x, -a.y); }
// cdiv: complex divide, a / b
static inline float2 cdiv(float2 a, float2 b) {
  float inv = 1.0f / (b.x * b.x + b.y * b.y);
  return (float2)((a.x * b.x + a.y * b.y) * inv, (a.y * b.x - a.x * b.y) * inv);
}
// cmac: fused multiply-accumulate, acc + a * b (same op order as replaced loops)
static inline float2 cmac(float2 acc, float2 a, float2 b) {
  return (float2)(acc.x + a.x * b.x - a.y * b.y, acc.y + a.x * b.y + a.y * b.x);
}
// cmacr: fused multiply-accumulate, acc + a * conj(b) (same op order as replaced)
static inline float2 cmacr(float2 acc, float2 a, float2 b) {
  return (float2)(acc.x + a.x * b.x + a.y * b.y, acc.y + a.y * b.x - a.x * b.y);
}

// ---- THP centered modulo ---------------------------------------------------
// cmod_axis: fold x onto [-period/2, period/2) via floor; bit-exact with the
// production datapath (edge discontinuity is inherent to the definition).
static inline float cmod_axis(float x, float period) {
  return x - period * floor((x + 0.5f * period) / period);
}
// cmod: fold both components of v onto [-period/2, period/2)
static inline float2 cmod(float2 v, float period) {
  return (float2)(cmod_axis(v.x, period), cmod_axis(v.y, period));
}

#endif  // HPOCL_CPLX_CLH
