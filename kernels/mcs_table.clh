// mcs_table.clh — 3GPP TS 38.214 64QAM CQI (MCS) table and the GMI-based
// code-rate selection rule; shared by host runtime/rate_main.cpp and device
// kernels/rate.cl.
// HPOCL_MCS_TABLE_CLH: include guard.
#ifndef HPOCL_MCS_TABLE_CLH
#define HPOCL_MCS_TABLE_CLH

// HPOCL_CQI_N: table size; index 0 is "out of range" (m = R = 0, never
// selected). SE is monotone non-decreasing, so a linear scan is a maximum.
#define HPOCL_CQI_N 16
// HPOCL_RATE_DEN: code-rate units, 1/1024 (SE = m * R / 1024).
#define HPOCL_RATE_DEN 1024

// HPOCL_TBL: storage class — __constant in OpenCL C (read-only, maps to BRAM),
// static const in C++ (per-TU copy, internal linkage, no ODR issue).
#ifdef __OPENCL_C_VERSION__
#define HPOCL_TBL __constant
#else
#define HPOCL_TBL static const
#endif
// kCqiM: CQI index -> modulation order m.
HPOCL_TBL int kCqiM[HPOCL_CQI_N] = {0, 2, 2, 2, 2, 2, 2,
                                    4, 4, 4, 6, 6, 6, 6, 6, 6};
// kCqiR: CQI index -> code rate R in units of 1/1024.
HPOCL_TBL int kCqiR[HPOCL_CQI_N] = {0, 78, 120, 193, 308, 449, 602,
                                    378, 490, 616, 466, 567, 666, 772, 873, 948};

// cqi_se: spectral efficiency of CQI index j, m * R / 1024 bits/channel use;
// 0 if j is out of range.
static inline float cqi_se(int j) {
  if (j < 0 || j >= HPOCL_CQI_N) return 0.0f;
  return (float)kCqiM[j] * (float)kCqiR[j] / (float)HPOCL_RATE_DEN;
}

// HPOCL_GMI_MAX: GMI upper bound = max modulation order (8 bits/symbol); values
// above it are upstream faults, not measurements (refused, not scheduled).
#define HPOCL_GMI_MAX 8.0f
// cqi_select: highest CQI index with SE <= gmi + eps, or -1 on outage; eps is a
// slack that resolves fp32 ties upward; -1 also rejects NaN, <= 0 and +inf.
static inline int cqi_select(float gmi, float eps) {
  if (!(gmi > 0.0f)) return -1;              // rejects NaN and <= 0
  if (!(gmi <= HPOCL_GMI_MAX)) return -1;    // rejects +inf (and NaN again)
  int best = -1;
  for (int j = 1; j < HPOCL_CQI_N; ++j)
    if (cqi_se(j) <= gmi + eps) best = j;
  return best;
}

// cqi_info_rate: delivered information rate, min(SE(j), gmi) bits/channel use;
// 0 on outage or out of range (capped: R * m <= GMI is the support condition).
static inline float cqi_info_rate(float gmi, int j) {
  if (j < 0 || j >= HPOCL_CQI_N) return 0.0f;
  float se = cqi_se(j);
  return gmi > se ? se : gmi;   // capped: R*m <= GMI is the support condition
}

#endif  // HPOCL_MCS_TABLE_CLH
