// switch_law.clh — O(1) surrogate SVD/THP switching law (needs only lambda_min
// and g_min); shared by host ref/hp_ref.cpp and device kernels/switch_threshold.cl.
// NOT the deployed closed-form law of threshold_cf.cl / main.tex.
// HPOCL_SWITCH_LAW_CLH: include guard.
#ifndef HPOCL_SWITCH_LAW_CLH
#define HPOCL_SWITCH_LAW_CLH

// HPOCL_GMIN_FLOOR: floor for g_min (geometric mean of squared singular values,
// can underflow to 0 on rank-deficient channels) — keeps tau finite.
#define HPOCL_GMIN_FLOOR   1e-12f
// HPOCL_TAULIN_FLOOR: log10 argument floor; 10*log10(1e-20) = -200 dB, far below
// any operating point, so clamping there is indistinguishable from -inf.
#define HPOCL_TAULIN_FLOOR 1e-20f

// switch_tau_lin: linear surrogate threshold, (nt/nrf) * eta * (lambda_min / g_min).
static inline float switch_tau_lin(float lambda_min, float g_min,
                                   float nt, float nrf, float eta) {
  float gm = g_min > HPOCL_GMIN_FLOOR ? g_min : HPOCL_GMIN_FLOOR;
  return (nt / nrf) * eta * (lambda_min / gm);
}

// switch_tau_db: switch_tau_lin in dB (10*log10), floored at HPOCL_TAULIN_FLOOR.
static inline float switch_tau_db(float tau_lin) {
  return 10.0f * log10(tau_lin > HPOCL_TAULIN_FLOOR ? tau_lin : HPOCL_TAULIN_FLOOR);
}

// switch_selects_thp: 1 = THP branch, 0 = SVD branch; "THP if s >= tau" (>= is
// the contract, matching main.tex and ref/pipeline.cpp).
static inline int switch_selects_thp(float metric_db, float tau_db) {
  return metric_db >= tau_db ? 1 : 0;
}

#endif  // HPOCL_SWITCH_LAW_CLH
