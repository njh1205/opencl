       float2 pa = P[r * d + k - 1], pb = P[r * d + nx - 1];
       P[r * d + k - 1] = c * pa + s * pb;
       P[r * d + nx - 1] = -s * pa + c * pb;
+    }
+    for (int r = 0; r < qrows; ++r) {
