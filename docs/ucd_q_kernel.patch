       for (int r = 0; r < rows; ++r) {
         float2 tp = P[r * d + nx - 1]; P[r * d + nx - 1] = P[r * d + pivot - 1];
         P[r * d + pivot - 1] = tp;
+      }
+      for (int r = 0; r < qrows; ++r) {
